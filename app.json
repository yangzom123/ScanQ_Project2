{
  "expo": {
    "name": "ScanQ",
    "slug": "scanq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scanq.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ScanQ uses the camera to scan your tutor's attendance QR code."
      }
    },
    "android": {
      "package": "com.scanq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ScanQ uses the camera to scan your tutor's attendance QR code."
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
